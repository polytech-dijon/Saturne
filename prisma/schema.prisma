generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  EDITOR
}

enum PosterStatus {
  DRAFT
  READY
  DISABLED
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  posters      Poster[]
}

model Poster {
  id              Int          @id @default(autoincrement())
  title           String
  description     String?
  scheduledAt     DateTime? // start broadcasting date/time
  deleteAt        DateTime? // automatic deletion date/time
  displayDuration Int // display duration in seconds
  status          PosterStatus @default(DRAFT)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  createdBy Int
  creator   User @relation(fields: [createdBy], references: [id])

  filePath String @unique // ex: "2025/09/uuid.ext" relative to UPLOAD_ROOT
  fileMime String // image/png, video/mp4, ...
  fileSize Int // bytes
  fileName String // original name
}
